{
  "name": "paycheck-two",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first paycheck planning companion.",
  "scripts": {
    "dev": "concurrently -k -n agent,web -c green,cyan \"npm:dev:agent\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:agent": "tsx watch server/index.ts",
    "agent": "tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/plan.test.js && tsx --test test/*.test.ts",
    "eval:fixtures": "tsx evals/run-fixtures.ts",
    "eval:live": "tsx evals/run-live.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.1.2"
  },
  "dependencies": {
    "@strands-agents/sdk": "^1.13.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  }
}
